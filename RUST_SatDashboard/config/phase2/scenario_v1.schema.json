{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "satdash.scenario/v1",
  "title": "SatDashboard Phase 2 場景",
  "type": "object",
  "required": [
    "schema",
    "id",
    "time",
    "frames",
    "objects",
    "screening",
    "force_model"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "satdash.scenario/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,64}$"
    },
    "description": {
      "type": "string"
    },
    "time": {
      "type": "object",
      "required": [
        "system"
      ],
      "additionalProperties": false,
      "properties": {
        "system": {
          "const": "UTC"
        },
        "eop_source": {
          "type": "string"
        },
        "eop_version": {
          "type": "string"
        },
        "leap_seconds_version": {
          "type": "string"
        },
        "space_weather_version": {
          "type": "string"
        }
      }
    },
    "frames": {
      "type": "object",
      "required": [
        "propagation"
      ],
      "additionalProperties": false,
      "properties": {
        "sgp4_output": {
          "const": "TEME"
        },
        "propagation": {
          "const": "GCRF"
        }
      }
    },
    "analysis_time": {
      "type": "string",
      "format": "date-time"
    },
    "objects": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "role",
          "name",
          "ephemeris",
          "hbr_m"
        ],
        "additionalProperties": false,
        "properties": {
          "role": {
            "enum": [
              "primary",
              "secondary"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "norad_id": {
            "type": "integer",
            "minimum": 0
          },
          "orbit_regime": {
            "enum": [
              "LEO",
              "MEO",
              "GEO",
              "HEO"
            ]
          },
          "ephemeris": {
            "$ref": "#/$defs/ephemeris"
          },
          "covariance": {
            "$ref": "#/$defs/covariance"
          },
          "hbr_m": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "mass_kg": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "area_to_mass_m2kg": {
            "type": "number",
            "minimum": 0
          },
          "cd": {
            "type": "number",
            "minimum": 0
          },
          "cr": {
            "type": "number",
            "minimum": 0
          },
          "propulsion": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "isp_s": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "dv_budget_ms": {
                "type": "number",
                "minimum": 0
              },
              "min_notice_s": {
                "type": "number",
                "minimum": 0
              },
              "thrust_dirs": {
                "type": "array",
                "items": {
                  "enum": [
                    "R",
                    "T",
                    "N",
                    "-R",
                    "-T",
                    "-N"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "screening": {
      "type": "object",
      "required": [
        "start",
        "duration_s",
        "threshold_km"
      ],
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "duration_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2592000
        },
        "step_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 600
        },
        "threshold_km": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "propagator": {
          "enum": [
            "auto",
            "sgp4",
            "numerical"
          ]
        },
        "coarse_step_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        },
        "min_step_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 60
        }
      }
    },
    "force_model": {
      "type": "object",
      "required": [
        "zonal",
        "drag"
      ],
      "additionalProperties": false,
      "properties": {
        "zonal": {
          "type": "boolean"
        },
        "drag": {
          "type": "boolean"
        },
        "density_model": {
          "enum": [
            "exponential",
            "nrlmsise00"
          ]
        }
      }
    },
    "conjunction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tca": {
          "type": "string",
          "format": "date-time"
        },
        "miss_km": {
          "type": "number",
          "minimum": 0
        },
        "source": {
          "type": "string"
        }
      }
    },
    "maneuver_search": {
      "type": "object",
      "required": [
        "window_rel_tca_s"
      ],
      "additionalProperties": false,
      "properties": {
        "window_rel_tca_s": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "dv_ms": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "pc_target": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "min_miss_km": {
          "type": "number",
          "minimum": 0
        },
        "feasibility_check": {
          "type": "boolean"
        },
        "secondary_screening": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "catalog": {
              "enum": [
                "active",
                "full",
                "provided"
              ]
            },
            "window_days": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "objects": {
              "type": "array",
              "maxItems": 200,
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "ephemeris"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "norad_id": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "ephemeris": {
                    "$ref": "#/$defs/ephemeris"
                  }
                }
              }
            }
          }
        },
        "n_times": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "n_dv": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "max_verify": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "rpo_limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keep_out_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_closing_ms": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "corridor_half_angle_deg": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 90
        },
        "corridor_axis": {
          "enum": [
            "+R",
            "-R",
            "+T",
            "-T",
            "+N",
            "-N"
          ]
        },
        "corridor_range_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "closing_range_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fov_deg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "comm_loss": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "strategy": {
              "const": "abort_to_hold"
            },
            "trigger_s": {
              "type": "number",
              "minimum": 0
            },
            "safe_orbits": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10
            }
          }
        }
      }
    },
    "monte_carlo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "rng": {
          "enum": [
            "pcg64"
          ]
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "samples_file": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "rpo": {
      "type": "object",
      "required": [
        "sequence"
      ],
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "type",
                  "to_rtn_m",
                  "duration_s"
                ],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "transfer"
                  },
                  "to_rtn_m": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "duration_s": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 86400
                  },
                  "corridor": {
                    "type": "boolean"
                  },
                  "label": {
                    "type": "string",
                    "maxLength": 40
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "type",
                  "duration_s"
                ],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "hold"
                  },
                  "duration_s": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 86400
                  },
                  "deadband_m": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "at_rtn_m": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "corridor": {
                    "type": "boolean"
                  },
                  "label": {
                    "type": "string",
                    "maxLength": 40
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "type",
                  "revolutions"
                ],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "fly_around"
                  },
                  "revolutions": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 5
                  },
                  "corridor": {
                    "type": "boolean"
                  },
                  "label": {
                    "type": "string",
                    "maxLength": 40
                  }
                }
              }
            ]
          }
        },
        "control": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "retarget_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "deadband_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "max_burn_ms": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "abort": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "update_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "max_dv_ms": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "margin": {
              "type": "number",
              "minimum": 1
            },
            "execution_error": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mag_frac_sigma": {
                  "type": "number",
                  "minimum": 0
                },
                "point_deg_sigma": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        },
        "fault": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "comm_loss_start_s": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    }
  },
  "$defs": {
    "covariance": {
      "type": "object",
      "required": [
        "mode",
        "source",
        "independent_of_other"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "demo",
            "propagated"
          ]
        },
        "epoch": {
          "type": "string",
          "format": "date-time"
        },
        "frame": {
          "enum": [
            "RTN",
            "GCRF"
          ]
        },
        "rtn_definition": {
          "type": "string"
        },
        "velocity_convention": {
          "enum": [
            "inertial_velocity_components",
            "rotating_frame_derivative"
          ]
        },
        "units": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pos": {
              "const": "km"
            },
            "vel": {
              "const": "km/s"
            },
            "cross": {
              "const": "km^2/s"
            }
          }
        },
        "sigma_km": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "matrix_6x6": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 6,
            "maxItems": 6
          }
        },
        "source": {
          "enum": [
            "assumed",
            "cdm",
            "od"
          ]
        },
        "independent_of_other": {
          "type": "boolean"
        },
        "propagation": {
          "type": "object"
        },
        "maneuver_execution_error": {
          "type": "object",
          "required": [
            "included"
          ],
          "additionalProperties": false,
          "properties": {
            "included": {
              "type": "boolean"
            },
            "mag_frac_sigma": {
              "type": "number",
              "minimum": 0
            },
            "point_deg_sigma": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "ephemeris": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "line1",
            "line2"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "TLE"
            },
            "line1": {
              "type": "string",
              "minLength": 69,
              "maxLength": 69
            },
            "line2": {
              "type": "string",
              "minLength": 69,
              "maxLength": 69
            },
            "source": {
              "type": "string"
            },
            "retrieved": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "epoch",
            "frame",
            "r_km",
            "v_kms"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "state"
            },
            "epoch": {
              "type": "string",
              "format": "date-time"
            },
            "frame": {
              "enum": [
                "GCRF",
                "TEME"
              ]
            },
            "r_km": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "v_kms": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "source": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "of",
            "r_m",
            "v_ms"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "rtn_offset"
            },
            "of": {
              "const": "primary"
            },
            "r_m": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "v_ms": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "velocity_convention": {
              "const": "rotating_frame_derivative"
            },
            "source": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
